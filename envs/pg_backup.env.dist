# PostgreSQL connection
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=

# Space-separated list of databases to back up
DATABASES=

# Age public encryption key
# Generate a key pair with: age-keygen
AGE_RECIPIENT=

# Backup settings
BACKUP_PREFIX=
RETENTION_DAYS=30

# Rclone settings
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_DEST=