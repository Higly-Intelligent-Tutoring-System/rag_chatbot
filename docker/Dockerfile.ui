# Use the official Python image as the base
FROM python:3.13-slim

# Set environment variables 
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_DEV=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Create non-root user for security
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

# Switch to non-root user
USER appuser

# Set the working directory
WORKDIR /rag-chatbot/

# Copy pyproject.toml first for better caching
COPY --chown=appuser:appgroup pyproject.toml .
COPY --chown=appuser:appgroup packages/ui/pyproject.toml /rag-chatbot/packages/ui/pyproject.toml


# Install Python dependencies
RUN uv sync --all-packages

# Copy files to image
COPY --chown=appuser:appgroup packages/ui /rag-chatbot/packages/ui

# Expose API
EXPOSE 8501

# Default command
WORKDIR /rag-chatbot/packages/ui
CMD ["uv", "run", "streamlit", "run",  "src/ui/main.py"]