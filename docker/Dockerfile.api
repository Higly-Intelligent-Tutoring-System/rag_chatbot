# Use the official Python image as the base
FROM python:3.13-slim

# Set environment variables 
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_DEV=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Create non-root user for security
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

# Switch to non-root user
USER appuser

# Set the working directory
WORKDIR /rag-chatbot/

# Copy pyproject.toml first for better caching
COPY --chown=appuser:appgroup pyproject.toml .
COPY --chown=appuser:appgroup packages/core/pyproject.toml packages/core/pyproject.toml
COPY --chown=appuser:appgroup packages/chatbot_orchestrator/pyproject.toml packages/chatbot_orchestrator/pyproject.toml
COPY --chown=appuser:appgroup packages/api/pyproject.toml packages/api/pyproject.toml

# Install Python dependencies
RUN uv sync --all-packages

# Copy files to image
COPY --chown=appuser:appgroup packages/core packages/core
COPY --chown=appuser:appgroup packages/chatbot_orchestrator packages/chatbot_orchestrator
COPY --chown=appuser:appgroup packages/api packages/api

# Expose API
EXPOSE 8000

# Exporting the paths to the modules for gunicorn
ENV PYTHONPATH="/rag-chatbot/packages/api/src:/rag-chatbot/packages/chatbot_orchestrator/src:/rag-chatbot/packages/core/src"

# Default command
CMD [ "uv", "run", "--package", "api", "--no-sync", "python", "-m", "gunicorn", "api.main:app", "--bind", "0.0.0.0:8000", "--workers", "1", "--worker-class", "uvicorn_worker.UvicornWorker", "--timeout", "180", "--graceful-timeout", "30", "--keep-alive", "5", "--access-logfile", "-", "--error-logfile", "-" ]