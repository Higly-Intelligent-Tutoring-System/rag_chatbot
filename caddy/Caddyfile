:8080 {
  handle /api/ita/* {
    uri strip_prefix /api/ita
    reverse_proxy api:8000
  }
  
  handle /api/slo/* {
    uri strip_prefix /api/slo
    reverse_proxy api2:8000
  }

  handle /api/esp/* {
    uri strip_prefix /api/esp
    reverse_proxy api3:8000
  }

  handle /api/rou/* {
    uri strip_prefix /api/rou
    reverse_proxy api4:8000
  }

  handle /api/ltu/* {
    uri strip_prefix /api/ltu
    reverse_proxy api5:8000
  }

  # Fallback for /token without university prefix (routes to default API)
  handle /token {
    reverse_proxy api:8000  # Default to first instance
  }

  handle {
    reverse_proxy ui:8501
  }
}